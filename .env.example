# Neon PostgreSQL Connection String (Serverless Pooler / Direct)
# Found in your Neon Console: Dashboard > Connection Details
# Ensure ?sslmode=require is appended.
#
# NOTE: Because we use the connectionless @neondatabase/serverless HTTP driver,
# Neon will automatically suspend after 5 minutes of idle time, consuming ZERO compute hours when not in use.
DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-sample-pooler.c-2.neon.tech/neondb?sslmode=require

# Cloudflare Pages / Local Dev
VITE_APP_TITLE=Doha Live Entertainment IP Hub
